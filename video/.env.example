# Chave do Google AI Studio: https://aistudio.google.com/apikey
# Copie este arquivo para .env e preencha. O .env nao vai pro git.
GEMINI_API_KEY=

# Opcionais. Sem eles, os scripts usam o primeiro modelo compativel da conta.
# Rode `npm run modelos` para ver o que a sua chave libera.
MODELO_IMAGEM=
MODELO_VIDEO=
